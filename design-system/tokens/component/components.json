{
  "button": {
    "min-height":   { "$type": "dimension", "$value": "{size.tap-target}" },
    "radius":       { "$type": "dimension", "$value": "{radius.md}" },
    "padding-x":    { "$type": "dimension", "$value": "18px" },
    "padding-y":    { "$type": "dimension", "$value": "{space.2}" },
    "font-weight":  { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
  },
  "input": {
    "min-height":   { "$type": "dimension", "$value": "{size.tap-target}" },
    "radius":       { "$type": "dimension", "$value": "{radius.md}" },
    "padding-x":    { "$type": "dimension", "$value": "{space.3}" },
    "padding-y":    { "$type": "dimension", "$value": "{space.2}" }
  },
  "chip": {
    "min-height":   { "$type": "dimension", "$value": "{size.control-sm}" },
    "radius":       { "$type": "dimension", "$value": "{radius.pill}" },
    "padding-x":    { "$type": "dimension", "$value": "14px" },
    "padding-y":    { "$type": "dimension", "$value": "6px" },
    "gap":          { "$type": "dimension", "$value": "6px" }
  },
  "switch": {
    "width":        { "$type": "dimension", "$value": "46px" },
    "height":       { "$type": "dimension", "$value": "28px" },
    "knob-size":    { "$type": "dimension", "$value": "22px" },
    "knob-inset":   { "$type": "dimension", "$value": "3px" },
    "knob-travel":  { "$type": "dimension", "$value": "18px" }
  },
  "article": {
    "title-size":   { "$type": "dimension", "$value": "{font.size.title}" },
    "padding-y":    { "$type": "dimension", "$value": "{space.5}" },
    "gap":          { "$type": "dimension", "$value": "14px" }
  }
}
