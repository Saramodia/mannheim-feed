{
  "color": {
    "$type": "color",
    "$description": "Light theme = DAYLIGHT.",
    "bg": {
      "page":    { "$value": "{color.sand.50}",  "$description": "App background." },
      "surface": { "$value": "{color.sand.25}",  "$description": "Cards, inputs, tab bar." }
    },
    "text": {
      "primary":   { "$value": "{color.sand.800}" },
      "secondary": { "$value": "{color.sand.600}", "$description": "Meta text, hints, inactive controls." },
      "on-accent": { "$value": "{color.sand.25}",  "$description": "Text and icons on the accent colour." }
    },
    "border": {
      "default": { "$value": "{color.sand.200}", "$description": "Dividers, outlines, switch track off." }
    },
    "accent": {
      "default": { "$value": "{color.ember.600}", "$description": "Primary colour: actions, links, selected state." },
      "soft":    { "$value": "{color.sun.100}",   "$description": "Tinted background for secondary emphasis." }
    },
    "feedback": {
      "danger": { "$value": "{color.rose.700}", "$description": "Errors and warnings only." }
    },
    "focus": {
      "ring": { "$value": "{color.ember.600}" }
    },
    "icon": {
      "default": { "$value": "{color.sand.600}",  "$description": "Icons beside text, inactive tabs. In code, icons use currentColor and inherit this from their parent." },
      "active":  { "$value": "{color.ember.600}", "$description": "Icon of the selected tab or item." }
    },
    "brand": {
      "accent-mark": { "$value": "{color.sun.500}", "$description": "Gold square in the logo. Not for UI." },
      "mark-bg":     { "$value": "{color.ember.600}", "$description": "Logo and app icon background." }
    },
    "control": {
      "knob": { "$value": "{color.sand.0}", "$description": "Switch knob." }
    }
  }
}
